# Copy this file to .env for local development. Never commit .env.
# Use Stripe test-mode keys locally, never production keys.

DEFAULT_BOOK_IDS=<UUID of the featured book>
DELIVERY_EMAIL=development@wayswemage.test
CUSTOMER_SUPPORT_EMAIL_ADDRESS=support@wayswemage.test

# Optional local integrations
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
GOOGLE_ANALYTICS_MEASUREMENT_ID=
ROLLBAR_ACCESS_TOKEN=
ROLLBAR_JS_TOKEN=

# Google sign-in. Use the development OAuth client, whose redirect URI is
# https://dev.wayswemage.com/mages/auth/google_oauth2/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional outbound links shown in the navigation/footer
FACEBOOK_PAGE_URL=https://www.facebook.com/wayswemage/
TWITTER_PAGE_URL=https://twitter.com/wayswemage
YOUTUBE_PAGE_URL=https://www.youtube.com/channel/UC9hSFx7EGe1G1-0Jl_uQbXA
