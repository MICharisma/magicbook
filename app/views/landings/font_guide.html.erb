<section class="font-preview">
  <p class="font-preview-kicker">Already on the site — Google Fonts</p>
  <h1 class="font-preview-title fondamento">Fondamento</h1>
  <p class="font-preview-lede">
    Calligraphic book face. Chapter titles already use it. Regular and italic from
    <%= link_to "Google Fonts", "https://fonts.google.com/specimen/Fondamento", target: "_blank", rel: "noopener" %>.
  </p>

  <div class="font-preview-cuts">
    <article>
      <h2>Regular</h2>
      <p class="fondamento">Lightning Bolt · Jace, the Mind Sculptor · Hobbit Characters</p>
      <p class="fondamento">ABCDEFGHIJKLMNOPQRSTUVWXYZ</p>
      <p class="fondamento">abcdefghijklmnopqrstuvwxyz 0123456789</p>
    </article>
    <article>
      <h2>Italic</h2>
      <p class="fondamento-italic">Creature — Human Wizard · Instant · Legendary Planeswalker</p>
      <p class="fondamento-italic">ABCDEFGHIJKLMNOPQRSTUVWXYZ</p>
      <p class="fondamento-italic">abcdefghijklmnopqrstuvwxyz 0123456789</p>
    </article>
    <article>
      <h2>As a chapter title</h2>
      <p class="fondamento font-preview-chapter">The Council of Elrond</p>
      <p class="fondamento-italic">A free chapter from the featured book</p>
    </article>
  </div>
</section>

<% selected_fonts.each do |font| %>
  <div style="font-family: '<%= font %>';">
    <%= font %>: = >
    Pappolidge farnicola est bard rardote ramplingtosh beringe.. frest!
  </div>
  <%= tag.br %>
<% end %>
