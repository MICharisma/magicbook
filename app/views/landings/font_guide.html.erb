<section class="font-preview">
  <p class="font-preview-kicker">Live on the site — still loaded from GitHub, not copied into the app</p>
  <h1 class="font-preview-title">Beleren</h1>
  <p class="font-preview-lede">
    Linked from
    <%= link_to "regularwave/beleren-bold-woff2", "https://github.com/regularwave/beleren-bold-woff2", target: "_blank", rel: "noopener" %>
    (woff2 of
    <%= link_to "Saeris/typeface-beleren-bold", "https://github.com/Saeris/typeface-beleren-bold", target: "_blank", rel: "noopener" %>).
    Unofficial fan webfonts; typeface © Wizards of the Coast.
  </p>

  <div class="font-preview-cuts">
    <article>
      <h2>Beleren Bold</h2>
      <p class="beleren-bold">Lightning Bolt · Jace, the Mind Sculptor · Hobbit Characters</p>
      <p class="beleren-bold">ABCDEFGHIJKLMNOPQRSTUVWXYZ</p>
      <p class="beleren-bold">abcdefghijklmnopqrstuvwxyz 0123456789</p>
    </article>
    <article>
      <h2>Beleren Small Caps</h2>
      <p class="beleren-small-caps">Creature — Human Wizard · Instant · Legendary Planeswalker</p>
      <p class="beleren-small-caps">ABCDEFGHIJKLMNOPQRSTUVWXYZ</p>
      <p class="beleren-small-caps">abcdefghijklmnopqrstuvwxyz 0123456789</p>
    </article>
    <article>
      <h2>Small Caps Italic</h2>
      <p class="beleren-small-caps-italic">Flavor text and asides</p>
