<section class="tagging-apply"
  id="<%= dom_id(taggable, :apply_tag) %>"
  data-controller="apply-existing-tag"
  data-apply-existing-tag-limit-value="8">
  <% if available_tags.any? %>
    <% if available_tags.size > 8 %>
      <input type="search"
        class="tagging-filter"
        data-apply-existing-tag-target="query"
        data-action="input->apply-existing-tag#filter"
        aria-label="Filter tags"
        autocomplete="off">
    <% end %>
    <div class="tagging-options" role="list">
      <% available_tags.each do |tag| %>
        <div data-apply-existing-tag-target="option"
          data-label="<%= [tag.tag_context&.name, tag.name, tag.slug].compact.join(" ") %>">
          <%= button_to admin_taggings_path,
            params: {
              tagging: {
                tag_id: tag.id,
                taggable_type: taggable.class.name,
                taggable_id: taggable.id
              }
            },
            class: ["tagging-chip", "tagging-option", ("is-styled" if tag.tag_context)],
            style: tag_style_css(tag.tag_context),
            aria: { label: tag_label(tag) },
            form: { class: "tagging-option-form", data: { turbo: true, turbo_stream: true, turbo_frame: "_top" } } do %>
            <%= tag_chip_inner(tag) %>
          <% end %>
        </div>
      <% end %>
    </div>
    <button type="button"
      class="tagging-more"
      hidden
      data-apply-existing-tag-target="more"
      data-action="apply-existing-tag#showMore">More</button>
    <p class="tagging-filter-empty" data-apply-existing-tag-target="empty" hidden>None</p>
  <% end %>
</section>
